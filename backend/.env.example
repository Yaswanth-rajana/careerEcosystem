# ==============================================================================
# PATHWAY.ECO BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Database (MongoDB Replica Set required for transactions & slot concurrency)
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/careerEcoSystem?replicaSet=rs0"

# Application Environment
NODE_ENV="development"

# Portal Base URLs (Used for secure transactional email deep-linking)
APP_BASE_URL="http://localhost:3000"          # Candidate / Student Portal
MENTOR_PORTAL_URL="http://localhost:3003"     # Mentor Portal
RECRUITER_PORTAL_URL="http://localhost:3004"   # Recruiter / Employer Portal

# Transactional Email Provider (ZeptoMail / SMTP)
# When ZEPTO_API_KEY is not configured or empty, the backend runs in graceful
# simulation mode for local development and test runs (no real emails sent, logged to console).
ZEPTO_API_KEY="your-zeptomail-send-mail-token-or-api-key"
FROM_EMAIL="notify@smven.com"
FROM_NAME="PATHWAY.ECO Team"
# ZEPTOMAIL_BOUNCE_ADDRESS="bounce@yourdomain.com"
# ZEPTOMAIL_API_URL="https://api.zeptomail.in/v1.1/email"

# Additional Services (Document conversion, OAuth)
GOTENBERG_URL="http://localhost:3001"
MAX_UPLOAD_SIZE_MB="25"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
