{
  "name": "career-ecosystem-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "admin",
    "mentor",
    "recruiter"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:admin": "npm --prefix admin run dev",
    "dev:mentor": "npm --prefix mentor run dev",
    "dev:recruiter": "npm --prefix recruiter run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:admin": "npm --prefix admin run build",
    "build:mentor": "npm --prefix mentor run build",
    "build:recruiter": "npm --prefix recruiter run build",
    "build": "npm run db:generate && npm run db:push && npm run build:backend && npm run build:frontend && npm run build:admin && npm run build:mentor && npm run build:recruiter",
    "db:push": "npm --prefix backend run db:push",
    "db:generate": "npm --prefix backend run db:generate",
    "db:studio": "npm --prefix backend run db:studio"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  }
}
